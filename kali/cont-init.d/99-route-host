#!/usr/bin/with-contenv bash
# SERVER_IP (10.0.253.1) is on the macvlan parent. Frames sent to that address
# out the macvlan NIC never reach the host. A /32 via the compose bridge
# delivers SSH to sshd on the ProLiant.
# Do not add ip rules here. Policy routing stopped Caddy reaching this desktop,
# and the browser showed a bad gateway.
set -eu
host="${SERVER_IP:-}"
if [ -z "$host" ]; then
  echo "SERVER_IP is unset; not adding a host route" >&2
  exit 0
fi
if ! command -v ip >/dev/null 2>&1; then
  apt-get update
  apt-get install -y --no-install-recommends iproute2
fi
gw=$(ip -4 route show default | awk -v host="$host" '$3 != host {print $3; exit}')
if [ -z "$gw" ]; then
  echo "no bridge gateway; not routing $host" >&2
  exit 0
fi
ip route replace "${host}/32" via "$gw"
echo "route ${host}/32 via ${gw}"
