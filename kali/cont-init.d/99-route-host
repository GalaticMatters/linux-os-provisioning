#!/usr/bin/with-contenv bash
# SERVER_IP (10.0.253.1) is on the macvlan parent. Frames sent to that address
# out the macvlan NIC never reach the host. A /32 via the compose bridge
# delivers SSH to sshd on the ProLiant.
# Do not add ip rules here. Policy routing stopped Caddy reaching this desktop,
# and the browser showed a bad gateway.
# Do not delete /var/lib/apt/lists/lock or dpkg locks. Wait, or skip.
set -eu
host="${SERVER_IP:-}"
if [ -z "$host" ]; then
  echo "SERVER_IP is unset; not adding a host route" >&2
  exit 0
fi

apt_locked() {
  if command -v fuser >/dev/null 2>&1; then
    fuser /var/lib/apt/lists/lock >/dev/null 2>&1 && return 0
    fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && return 0
    fuser /var/lib/dpkg/lock >/dev/null 2>&1 && return 0
  fi
  if command -v flock >/dev/null 2>&1; then
    for lock in /var/lib/apt/lists/lock /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock; do
      [ -e "$lock" ] || continue
      if ! flock -n "$lock" -c true 2>/dev/null; then
        return 0
      fi
    done
  fi
  return 1
}

wait_apt_lock() {
  n=0
  while [ "$n" -lt 36 ]; do
    if ! apt_locked; then
      return 0
    fi
    echo "apt lock held; waiting. Do not rm /var/lib/apt/lists/lock."
    if command -v fuser >/dev/null 2>&1; then
      fuser -v /var/lib/apt/lists/lock /var/lib/dpkg/lock-frontend 2>&1 | cat || true
    fi
    n=$((n + 1))
    sleep 5
  done
  echo "apt lock still held after wait; not calling apt-get" >&2
  return 1
}

if ! command -v ip >/dev/null 2>&1; then
  if wait_apt_lock; then
    apt-get update
    apt-get install -y --no-install-recommends iproute2
  else
    echo "ip is missing and apt is busy; skip host route" >&2
    exit 0
  fi
fi
if ! command -v ip >/dev/null 2>&1; then
  echo "ip is missing; skip host route" >&2
  exit 0
fi
gw=$(ip -4 route show default | awk -v host="$host" '$3 != host {print $3; exit}')
if [ -z "$gw" ]; then
  echo "no bridge gateway; not routing $host" >&2
  exit 0
fi
ip route replace "${host}/32" via "$gw"
echo "route ${host}/32 via ${gw}"
