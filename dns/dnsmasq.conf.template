# Rendered at container start. Edit dns/dnsmasq.conf.template, not this file.
# Listen on every interface inside the container. Docker publishes the host
# port on SERVER_IP only. listen-address=0.0.0.0 makes dnsmasq ignore queries
# that arrive on the container's real address.
port=53
no-resolv
no-hosts
domain-needed
bogus-priv
stop-dns-rebind
rebind-localhost-ok
clear-on-reload
log-facility=-

# Names outside this zone.
server=__UPSTREAM_DNS_1__
server=__UPSTREAM_DNS_2__

# Do not forward the zone. Records are exact names, not a wildcard address=,
# because a wildcard would send the Ubuntu servers to the Kali server IP.
local=/__BASE_DOMAIN__/
conf-file=/tmp/records.conf
