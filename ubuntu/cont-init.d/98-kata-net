#!/usr/bin/with-contenv bash
# ubuntu111 is a Kata VM. Docker's embedded DNS (127.0.0.11) lives in the
# shim netns, not in this guest, so apt and curl look like "no internet".
# Compose gw_priority is not applied inside the VM; the macvlan default
# route (10.0.253.1) would send internet at the ProLiant instead of Docker
# NAT on the desktop bridge.
# Do not apt-get here. Do not delete /var/lib/apt/lists/lock.
set -eu

LAN_PREFIX="10.0.253."
VETH_PREFIX="10.255.111."
PUBLIC_DNS_1="${UPSTREAM_DNS_1:-1.1.1.1}"
PUBLIC_DNS_2="${UPSTREAM_DNS_2:-8.8.8.8}"

iface_name() {
  name=$1
  name=${name%%@*}
  name=${name%:}
  printf '%s\n' "$name"
}

wait_for_nics() {
  n=0
  while [ "$n" -lt 50 ]; do
    if ip -4 -o addr show 2>/dev/null | awk '$2 != "lo" { found = 1 } END { exit !found }'; then
      return 0
    fi
    n=$((n + 1))
    sleep 0.2
  done
  echo "kata-net: no non-loopback IPv4 after wait (Docker may still be attaching)" >&2
  return 1
}

wait_for_desktop() {
  n=0
  while [ "$n" -lt 25 ]; do
    desk=$(desktop_iface || true)
    if [ -n "$desk" ]; then
      ip link set "$desk" up || true
      echo "kata-net: desktop-bridge iface is ${desk}"
      return 0
    fi
    n=$((n + 1))
    sleep 0.2
  done
  echo "kata-net: no desktop-bridge IPv4 (not 10.0.253.0/24, not veth-peer)" >&2
  return 1
}

desktop_iface() {
  ip -4 -o addr show 2>/dev/null | while read -r _ name _ cidr _; do
    name=$(iface_name "$name")
    [ "$name" = "lo" ] && continue
    [ "$name" = "veth-peer" ] && continue
    case "$cidr" in
      ${LAN_PREFIX}*) continue ;;
      ${VETH_PREFIX}*) continue ;;
    esac
    printf '%s\n' "$name"
    return 0
  done
}

macvlan_iface() {
  ip -4 -o addr show 2>/dev/null | while read -r _ name _ cidr _; do
    name=$(iface_name "$name")
    [ "$name" = "lo" ] && continue
    case "$cidr" in
      ${LAN_PREFIX}*)
        printf '%s\n' "$name"
        return 0
        ;;
    esac
  done
}

gateway_on() {
  dev=$1
  via=$(ip -4 route show default dev "$dev" 2>/dev/null | awk '{ print $3; exit }')
  if [ -n "$via" ]; then
    printf '%s\n' "$via"
    return 0
  fi
  via=$(ip -4 route show dev "$dev" 2>/dev/null | awk '/^default/ { print $3; exit }')
  if [ -n "$via" ]; then
    printf '%s\n' "$via"
    return 0
  fi
  # Docker's bridge gateway is the first host of the kernel connected route.
  net=$(ip -4 route show dev "$dev" 2>/dev/null | awk '/proto kernel/ { print $1; exit }')
  [ -n "$net" ] || return 1
  network=${net%/*}
  IFS=. read -r a b c d <<EOF
$network
EOF
  printf '%s.%s.%s.%s\n' "$a" "$b" "$c" "$((d + 1))"
}

replace_resolv() {
  if [ ! -e /etc/resolv.conf ]; then
    return 0
  fi
  if ! grep -qE 'nameserver[[:space:]]+127\.0\.0\.11' /etc/resolv.conf 2>/dev/null; then
    echo "kata-net: resolv.conf is not Docker 127.0.0.11; leaving it"
    return 0
  fi
  tmp=/run/kata-resolv.conf
  {
    printf '%s\n' "nameserver ${PUBLIC_DNS_1}"
    if [ -n "$PUBLIC_DNS_2" ] && [ "$PUBLIC_DNS_2" != "$PUBLIC_DNS_1" ]; then
      printf '%s\n' "nameserver ${PUBLIC_DNS_2}"
    fi
    printf '%s\n' "options ndots:0"
  } > "$tmp"
  if printf '' >> /etc/resolv.conf 2>/dev/null; then
    cp "$tmp" /etc/resolv.conf
  else
    mount --bind "$tmp" /etc/resolv.conf || {
      echo "kata-net: could not replace 127.0.0.11 in resolv.conf" >&2
      return 0
    }
  fi
  echo "kata-net: DNS ${PUBLIC_DNS_1} ${PUBLIC_DNS_2} (127.0.0.11 is not in this VM)"
}

ensure_peer_hosts() {
  if grep -qE '(^|[[:space:]])kali111($|[[:space:]])' /etc/hosts 2>/dev/null; then
    return 0
  fi
  if printf '%s\n' "10.0.253.50 kali111" >> /etc/hosts 2>/dev/null; then
    echo "kata-net: added kali111 10.0.253.50 to /etc/hosts"
  fi
}

prefer_desktop_default() {
  desk=$(desktop_iface || true)
  mac=$(macvlan_iface || true)
  if [ -z "$desk" ]; then
    echo "kata-net: no desktop-bridge IPv4; internet depends on macvlan ${mac:-none}"
    return 0
  fi
  ip link set "$desk" up || true
  gw=$(gateway_on "$desk" || true)
  if [ -z "$gw" ]; then
    echo "kata-net: desktop iface ${desk} has no gateway" >&2
    return 0
  fi
  current=$(ip -4 route show default 2>/dev/null | awk 'NR==1 { print $3; exit }')
  current_dev=$(ip -4 route show default 2>/dev/null | awk 'NR==1 {
    for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i+1); exit }
  }')
  if [ "$current_dev" = "$desk" ] && [ "$current" = "$gw" ]; then
    echo "kata-net: default route already via ${gw} dev ${desk}"
    return 0
  fi
  ip route replace default via "$gw" dev "$desk"
  echo "kata-net: default route via ${gw} dev ${desk} (desktop bridge, Docker NAT)"
  if [ -n "$mac" ]; then
    ip link set "$mac" up || true
    ip route replace "${LAN_PREFIX}0/24" dev "$mac" || true
  fi
}

if ! command -v ip >/dev/null 2>&1; then
  echo "kata-net: ip is missing; skip (do not apt-get while webtop may hold the lock)" >&2
  exit 0
fi

wait_for_nics || true
wait_for_desktop || true
replace_resolv
ensure_peer_hosts
prefer_desktop_default
echo "kata-net: interfaces (desktop bridge has the Docker IP; veth-peer is unnumbered)"
ip -br addr show || ip -br link show || true
ip -4 route show || true
cat /etc/resolv.conf || true
