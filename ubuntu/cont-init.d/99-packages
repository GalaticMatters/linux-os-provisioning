#!/usr/bin/with-contenv bash
# ubuntu111 startup package list. Survives recreate (bind-mounted from git).
# 98-kata-net already replaced 127.0.0.11. Wait for webtop's apt lock.
# Do not rm /var/lib/apt/lists/lock.
set -eu

PACKAGES="iputils-ping"

need_install=""
for pkg in $PACKAGES; do
  case "$pkg" in
    iputils-ping)
      if ! command -v ping >/dev/null 2>&1; then
        need_install="$need_install $pkg"
      fi
      ;;
    *)
      need_install="$need_install $pkg"
      ;;
  esac
done
need_install=${need_install# }

if [ -z "$need_install" ]; then
  echo "packages: ping is already present"
  command -v ping
  exit 0
fi

apt_locked() {
  if command -v fuser >/dev/null 2>&1; then
    fuser /var/lib/apt/lists/lock >/dev/null 2>&1 && return 0
    fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && return 0
    fuser /var/lib/dpkg/lock >/dev/null 2>&1 && return 0
  fi
  if command -v flock >/dev/null 2>&1; then
    for lock in /var/lib/apt/lists/lock /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock; do
      [ -e "$lock" ] || continue
      if ! flock -n "$lock" -c true 2>/dev/null; then
        return 0
      fi
    done
  fi
  return 1
}

wait_apt_lock() {
  n=0
  while [ "$n" -lt 36 ]; do
    if ! apt_locked; then
      return 0
    fi
    echo "apt lock held; waiting. Do not rm /var/lib/apt/lists/lock."
    n=$((n + 1))
    sleep 5
  done
  echo "apt lock still held after wait; not calling apt-get" >&2
  return 1
}

if ! wait_apt_lock; then
  echo "packages: skip install of${need_install}" >&2
  exit 0
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
# shellcheck disable=SC2086
apt-get install -y --no-install-recommends $need_install
echo "packages: installed${need_install}"
command -v ping || true
