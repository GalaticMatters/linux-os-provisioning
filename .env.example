# Copy to .env, edit the values below, then render before the first start
# if you changed anything other than TZ or the published ports:
#   cp .env.example .env
#   python3 scripts/render.py
#   docker compose up -d --build
#
# The repo already contains a render of these example values (30 and 30).

# Apex name. Kali desktops are https://kali01.${BASE_DOMAIN} and so on.
BASE_DOMAIN=cybersecurity.lan

# Timezone for Kali clocks and for the 02:00 reset.
# A tz database name, not a UTC offset. Examples: UTC, America/New_York, Europe/Berlin.
TZ=UTC

# LAN address of this Linux server. Kali names and the bundled DNS use this address.
# DNS is published on this address only, not on 127.0.0.1.
# This address is the server. Do not give it to a Kali or Ubuntu box.
SERVER_IP=10.0.253.1

# Host ports for Caddy. A non-default HTTPS port has to appear in the browser URL.
HTTP_PORT=80
HTTPS_PORT=443

# Host port for the bundled DNS service, bound on SERVER_IP.
DNS_PORT=53

# Marks the dnsmasq service. Start it with ./scripts/lab.sh dns-on.
# lab.sh on and off ignore this, so a lab reset does not stop DNS.
# Clear it if port 53 on SERVER_IP is already taken and you will install
# dns/records.conf on the resolver you already run.
COMPOSE_PROFILES=dns

# Forwarders for names outside BASE_DOMAIN.
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=1.0.0.1

# Fleet size. Two-digit names, so 1 through 99. Re-run scripts/render.py after a change.
KALI_COUNT=30
UBUNTU_COUNT=30

# Required. Macvlan parent for the Ubuntu servers. Must be the interface which
# already has 10.0.253.1 (`br-ex` or `eno1`). It must allow more than one MAC
# address. Check `ip -br addr` and replace the placeholder below with that name.
PARENT_IFACE=eth0

# LAN subnet, and the gateway on that interface. The gateway is this server.
# Ubuntu containers are attached to this network with their own addresses.
LAN_SUBNET=10.0.253.0/24
LAN_GATEWAY=10.0.253.1

# ubuntuserver is the persistent SSH box. It is not part of ubuntu01–ubuntu30.
UBUNTU_SERVER_IP=10.0.253.41

# ubuntu01 gets this address, ubuntu02 the next, through ubuntu30 at 10.0.253.40.
# 10.0.253.2 through 10.0.253.10 are reserved. Do not assign them to a box.
# The range must sit inside LAN_SUBNET and must not include 10.0.253.1.
# That address is the server.
# Do not use 10.0.253.50 through 10.0.253.54. scripts/render.py pins those
# to kali111, ubuntu111, ubuntu100, derek, and vyas.
# Do not use 10.0.253.55 through 10.0.253.84. scripts/render.py pins those
# to kali01 through kali30.
UBUNTU_IP_START=10.0.253.11

# Same account on every Ubuntu server. Not root.
SSH_USER=student

# One of these is required. Leave both empty here. Put the real value only in .env.
# SSH_PUBLIC_KEY is one single-line OpenSSH public key.
# Avoid `$` in SSH_PASSWORD (Compose treats `$` as interpolation; write `$$` if you need one).
SSH_PUBLIC_KEY=
SSH_PASSWORD=

# Account on kali111, ubuntu100, ubuntu111, and ubuntuserver. Not used by derek or vyas.
# Set the password here. Do not commit it.
DESKTOP_USER=van
DESKTOP_PASSWORD=

# derek and vyas each have their own account. Passwords have no default.
# Leave these empty here. Put the real passwords only in .env. Do not commit them.
DEREK_USER=derek
DEREK_PASSWORD=
VYAS_USER=vyas
VYAS_PASSWORD=

# Account inside each Kali desktop. The home directory is a tmpfs, not a folder on the server.
PUID=1000
PGID=1000

# RAM ceiling for each Kali home. Only written data consumes RAM.
DESKTOP_TMPFS_SIZE=2g

# Cloudflare tunnel token for ubuntu111.research101.stream.
# Leave unused until the tunnel exists. Start with:
#   docker compose --profile public up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
