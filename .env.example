# Copy to .env and edit SERVER_IP and TZ before starting.
#   cp .env.example .env

# Apex name. Desktops are https://kali.${BASE_DOMAIN} and so on.
BASE_DOMAIN=desktop.lan

# Timezone for the desktop clocks and for the 02:00 reset.
# This is a tz database name, not a UTC offset. Examples: UTC, America/New_York, Europe/Berlin.
TZ=UTC

# LAN address of this Linux server. Workstations open the desktops here.
# The bundled dnsmasq publishes DNS on this address only (not on 127.0.0.1).
SERVER_IP=192.168.1.10

# Host ports for Caddy. Leave these at 80 and 443 unless something else owns them.
# A non-default HTTPS port has to appear in the browser URL.
HTTP_PORT=80
HTTPS_PORT=443

# Host port for the bundled DNS service, bound on SERVER_IP.
DNS_PORT=53

# Enables the dnsmasq service. Remove dns from this list if you already run DNS
# and will use dns/desktop.lan.conf or dns/hosts.example instead.
COMPOSE_PROFILES=dns

# Forwarders used by the bundled dnsmasq for names outside BASE_DOMAIN.
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=1.0.0.1

# Account inside each desktop. The home directory is a tmpfs, not a folder on the server.
PUID=1000
PGID=1000

# RAM ceiling for each desktop's /config (the home directory). Only written data consumes RAM.
DESKTOP_TMPFS_SIZE=2g
